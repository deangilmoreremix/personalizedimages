# Supabase credentials
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# AI API Keys - Users can also enter their own keys via Settings > API Keys in-app
# Keys entered via the UI take priority over these values
# Get your keys from:
# - OpenAI: https://platform.openai.com/api-keys
# - Gemini: https://makersuite.google.com/app/apikey
# - Leonardo: https://app.leonardo.ai/settings
# - Giphy: https://developers.giphy.com/dashboard/
# - Freepik: https://www.freepik.com/api
VITE_OPENAI_API_KEY=your_openai_api_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_NANO_API_KEY=your_gemini_nano_api_key_here
VITE_LEONARDO_API_KEY=your_leonardo_api_key_here
VITE_GIPHY_API_KEY=your_giphy_api_key_here
VITE_FREEPIK_API_KEY=your_freepik_api_key_here

# Application Environment
# Available: development, staging, production
VITE_APP_ENV=development

# Optional configurations
VITE_OPENAI_ASSISTANT_ID=your_assistant_id_here
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
VITE_FEATURE_USE_MODERN_UI=true
VITE_FEATURE_ENABLE_BETA=false